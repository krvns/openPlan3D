# Dockge & Compose Configuration
COMPOSE_PROJECT_NAME=openplan3d

# Runtime Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
STORAGE_DIR=./data/projects

# Reverse Proxy & CSRF Headers (Nginx Proxy Manager / VPN)
# Set to your VPN internal origin, e.g.:
# - http://openplan3d.internal
# - http://openplan3d.tailnet-xyz.ts.net
# - http://10.8.0.5:3000
# If accessing via multiple VPN hostnames or raw IP over HTTP, you can leave ORIGIN empty.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ORIGIN=https://plan.homeiknow.com

# Authentication (Optional - recommended for public Internet deployments)
# Set AUTH_PASSWORD to enable password protection on all pages and /api/projects endpoints.
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_PASSWORD=
AUTH_SECRET=
# Optional username (if set, login requires both username and password)
AUTH_USERNAME=

# Injected by Dockge on build or via git rev-parse --short HEAD
GIT_HASH=

