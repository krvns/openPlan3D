# Dockge & Compose Configuration
COMPOSE_PROJECT_NAME=openplan3d

# Runtime Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Reverse Proxy & CSRF Headers (Nginx Proxy Manager)
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ORIGIN=https://plan.yourdomain.com

# Injected by Dockge on build or via git rev-parse --short HEAD
GIT_HASH=

